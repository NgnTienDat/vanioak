# Copy to .env and supply three unique local passwords before starting Compose.
# Values are literal; use single quotes for passwords containing $, # or spaces.
# Do not commit .env. Compose does not export these values to Maven automatically.
SERVER_PORT=8080

# Enable explicitly to create an ADMIN if this username does not exist.
# Supply credentials privately, then disable bootstrap and remove the password.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Independently generate and Base64-encode at least 32 random bytes for each key.
# Required at runtime; never reuse keys or commit real secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Identity Redis lookup cache; cache hits never extend its validation deadline.
API_KEY_REDIS_CACHE_TTL=30s
API_KEY_LOCAL_CACHE_TTL=5s
API_KEY_LOCAL_CACHE_MAX_SIZE=1000
INGESTION_PUBLISH_CONFIRM_TIMEOUT=5s

POSTGRES_DB=vanioak
POSTGRES_HOST_PORT=5432
POSTGRES_URL=jdbc:postgresql://localhost:5432/vanioak
POSTGRES_USERNAME=vanioak
POSTGRES_PASSWORD=

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=vanioak
CLICKHOUSE_PASSWORD=

REDIS_HOST=localhost
REDIS_HOST_PORT=6379
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_HOST_PORT=5672
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=vanioak
RABBITMQ_PASSWORD=
